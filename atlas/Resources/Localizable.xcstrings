    "SETTINGS_APPLE_FOOTER" : {
      "comment" : "Settings footer explaining why loading Apple pages is off by default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default: Apple's website terms don't allow reproducing its content or accessing it automatically without permission, so Atlas doesn't contact developer.apple.com and links to it instead. Turn this on only for personal use: the catalogue and pages are then loaded when you open them, with attribution, and opening a framework makes its whole API searchable by name (one request per framework, rechecked weekly). The Swift Programming Language is always available (Apache 2.0)."
          }
        }
      }
    },
